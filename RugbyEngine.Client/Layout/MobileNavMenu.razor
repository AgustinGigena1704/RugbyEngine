@using RugbyEngine.Shared.Menus
@inject MainMenuService MenuService
@inject NavigationManager NavigationManager
@implements IDisposable

<nav class="mobile-nav">
    <AuthorizeView>
        <Authorized>
            @if (_menus != null)
            {
                <ul class="mobile-nav__list list-none mb-0">
                    @foreach (var menu in _menus)
                    {
                        @RenderMobileMenu(menu)
                    }
                </ul>
            }
            else
            {
                <div class="p-4">
                    <div class="mobile-nav-skeleton mb-2"></div>
                    <div class="mobile-nav-skeleton mb-2"></div>
                    <div class="mobile-nav-skeleton"></div>
                </div>
            }
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    private List<MenuDto>? _menus;
    private readonly HashSet<string> _openGroups = [];

    protected override async Task OnInitializedAsync()
    {
        MenuService.ActiveMenuChanged += OnMenuChanged;
        _menus = await MenuService.GetMenuTreeAsync();
    }

    private void OnMenuChanged()
    {
        InvokeAsync(async () =>
        {
            _menus = await MenuService.GetMenuTreeAsync();
            StateHasChanged();
        });
    }

    private void ToggleGroup(string groupId)
    {
        if (!_openGroups.Remove(groupId))
            _openGroups.Add(groupId);
    }

    public void Dispose()
    {
        MenuService.ActiveMenuChanged -= OnMenuChanged;
    }

    private RenderFragment RenderMobileMenu(MenuDto menu) => __builder =>
    {
        // Group only when there are real lvl1 children (children that themselves have children)
        var hasLevel1Children = menu.Items?.Any(child => (child.Items?.Count ?? 0) > 0) ?? false;

        if (hasLevel1Children)
        {
            var groupId = menu.Title.Replace(" ", "");
            var isOpen = _openGroups.Contains(groupId);
            <li class="mobile-nav__group">
                <button class="mobile-nav__group-btn @(isOpen ? "" : "collapsed")" @onclick="() => ToggleGroup(groupId)"
                        aria-expanded="@(isOpen ? "true" : "false")">
                    @(menu.Title)
                    <svg class="mobile-nav__chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor"
                         viewBox="0 0 16 16">
                        <path fill-rule="evenodd"
                              d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z" />
                    </svg>
                </button>
                @if (isOpen)
                {
                    <ul class="list-none mobile-nav__sublist">
                        @foreach (var sub in menu.Items ?? Enumerable.Empty<RugbyEngine.Shared.Menus.MenuDto>())
                        {
                            var route = sub.Items?.FirstOrDefault(i => !string.IsNullOrWhiteSpace(i.Route))?.Route ?? ResolveRoute(sub);
                            if (!string.IsNullOrEmpty(route))
                            {
                                <li>
                                    <a class="mobile-nav__link mobile-nav__link--sub" href="@route">@(sub.Title)</a>
                                </li>
                            }
                        }
                    </ul>
                }
            </li>
        }
        else if (!string.IsNullOrEmpty(menu.Route))
        {
            // No lvl1 children — render as direct link to first lvl2 if any
            <li>
                <a class="mobile-nav__link mobile-nav__link--top" href="@GetTargetRouteForMenu(menu)">
                    @(menu.Title)
                </a>
            </li>
        }
        else
        {
            // Fallback: render group so descendants remain accessible
            var groupId = menu.Title.Replace(" ", "");
            var isOpen = _openGroups.Contains(groupId);
            <li class="mobile-nav__group">
                <button class="mobile-nav__group-btn @(isOpen ? "" : "collapsed")" @onclick="() => ToggleGroup(groupId)"
                        aria-expanded="@(isOpen ? "true" : "false")">
                    @(menu.Title)
                </button>
                @if (isOpen)
                {
                    <ul class="list-none mobile-nav__sublist">
                        @foreach (var sub in menu.Items ?? Enumerable.Empty<RugbyEngine.Shared.Menus.MenuDto>())
                        {
                            var route = sub.Items?.FirstOrDefault(i => !string.IsNullOrWhiteSpace(i.Route))?.Route ?? ResolveRoute(sub);
                            if (!string.IsNullOrEmpty(route))
                            {
                                <li>
                                    <a class="mobile-nav__link mobile-nav__link--sub" href="@route">@(sub.Title)</a>
                                </li>
                            }
                        }
                    </ul>
                }
            </li>
        }
    };

    private static string ResolveRoute(MenuDto item)
    {
        if (item.Items is { Count: > 0 })
        {
            var firstChildRoute = item.Items
                .Select(ResolveRoute)
                .FirstOrDefault(route => !string.IsNullOrWhiteSpace(route));

            if (!string.IsNullOrWhiteSpace(firstChildRoute))
                return firstChildRoute;
        }

        return item.Route ?? string.Empty;
    }

    private static string GetTargetRouteForMenu(MenuDto menu)
    {
        var firstLvl2 = menu.Items?
            .Where(l1 => (l1.Items?.Count ?? 0) > 0)
            .SelectMany(l1 => l1.Items ?? Enumerable.Empty<RugbyEngine.Shared.Menus.MenuDto>())
            .FirstOrDefault(l2 => !string.IsNullOrWhiteSpace(l2.Route));

        if (firstLvl2 != null) return firstLvl2.Route!;

        var rr = ResolveRoute(menu);
        if (!string.IsNullOrWhiteSpace(rr)) return rr;
        return menu.Route ?? string.Empty;
    }
}
