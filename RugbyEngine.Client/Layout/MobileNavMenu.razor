@using MudBlazor
@using RugbyEngine.Shared.Menus
@using RugbyEngine.Client.Services
@inject MainMenuService MenuService
@implements IDisposable

<MudNavMenu>
    <AuthorizeView>
        <Authorized>
            @if (_menus != null)
            {
                @foreach (var menu in _menus)
                {
                    @RenderMobileMenu(menu)
                }
            }
            else
            {
                <MudNavLink Icon="@Icons.Material.Filled.HourglassEmpty" Disabled="true">Cargando...</MudNavLink>
            }
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private List<MenuDTO>? _menus;

    protected override async Task OnInitializedAsync()
    {
        MenuService.ActiveMenuChanged += OnMenuChanged;
        _menus = await MenuService.GetMenuTreeAsync();
    }

    private void OnMenuChanged()
    {
        InvokeAsync(async () =>
        {
            _menus = await MenuService.GetMenuTreeAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        MenuService.ActiveMenuChanged -= OnMenuChanged;
    }

    private static RenderFragment RenderMobileMenu(MenuDTO menu) => __builder =>
    {
        var icon = !string.IsNullOrEmpty(menu.Icon) ? menu.Icon : Icons.Material.Filled.Circle;

        if (menu.Items != null && menu.Items.Any())
        {
            <MudNavGroup Title="@menu.Title" Icon="@icon" Expanded="false">
                @foreach (var sub in menu.Items)
                {
                    var subIcon = !string.IsNullOrEmpty(sub.Icon) ? sub.Icon : Icons.Material.Filled.Circle;
                    var route = !string.IsNullOrEmpty(sub.Route)
                        ? sub.Route
                        : sub.Items?.FirstOrDefault(i => !string.IsNullOrEmpty(i.Route))?.Route ?? string.Empty;

                    if (!string.IsNullOrEmpty(route))
                    {
                        <MudNavLink Icon="@subIcon" Href="@route">@sub.Title</MudNavLink>
                    }
                }
            </MudNavGroup>
        }
        else if (!string.IsNullOrEmpty(menu.Route))
        {
            <MudNavLink Icon="@icon" Href="@menu.Route">@menu.Title</MudNavLink>
        }
    };
}
