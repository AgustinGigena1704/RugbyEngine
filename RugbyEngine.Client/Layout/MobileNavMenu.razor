@using RugbyEngine.Shared.Menus
@inject MainMenuService MenuService
@implements IDisposable

<nav class="mobile-nav">
    <AuthorizeView>
        <Authorized>
            @if (_menus != null)
            {
                <ul class="mobile-nav__list list-unstyled mb-0">
                    @foreach (var menu in _menus)
                    {
                        @RenderMobileMenu(menu)
                    }
                </ul>
            }
            else
            {
                <div class="p-3">
                    <div class="mobile-nav-skeleton mb-2"></div>
                    <div class="mobile-nav-skeleton mb-2"></div>
                    <div class="mobile-nav-skeleton"></div>
                </div>
            }
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    private List<MenuDTO>? _menus;

    protected override async Task OnInitializedAsync()
    {
        MenuService.ActiveMenuChanged += OnMenuChanged;
        _menus = await MenuService.GetMenuTreeAsync();
    }

    private void OnMenuChanged()
    {
        InvokeAsync(async () =>
        {
            _menus = await MenuService.GetMenuTreeAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        MenuService.ActiveMenuChanged -= OnMenuChanged;
    }

    private static RenderFragment RenderMobileMenu(MenuDTO menu) => __builder =>
    {
        if (menu.Items != null && menu.Items.Any())
        {
            var collapseId = $"mob-collapse-{menu.Title.Replace(" ", "")}";
            <li class="mobile-nav__group">
                <button class="mobile-nav__group-btn collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="@($"#{collapseId}")"
                        aria-expanded="false">
                    @(menu.Title)
                    <svg class="mobile-nav__chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                    </svg>
                </button>
                <ul id="@collapseId" class="collapse list-unstyled mobile-nav__sublist">
                    @foreach (var sub in menu.Items)
                    {
                        var route = !string.IsNullOrEmpty(sub.Route)
                            ? sub.Route
                            : sub.Items?.FirstOrDefault(i => !string.IsNullOrEmpty(i.Route))?.Route ?? string.Empty;
                        if (!string.IsNullOrEmpty(route))
                        {
                            <li>
                                <a class="mobile-nav__link" href="@route">@(sub.Title)</a>
                            </li>
                        }
                    }
                </ul>
            </li>
        }
        else if (!string.IsNullOrEmpty(menu.Route))
        {
            <li>
                <a class="mobile-nav__link mobile-nav__link--top" href="@menu.Route">
                    @(menu.Title)
                </a>
            </li>
        }
    };
}



