@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject MainMenuService MenuService
@implements IDisposable

<span class="app-brand me-3" onclick="@(() => NavigationManager.NavigateTo("/"))">RugbyEngine</span>

<AuthorizeView>
    <Authorized>
        <!-- Desktop nav (md+) -->
        <div class="d-none d-md-flex align-items-center gap-1 flex-grow-1">
            @if (_menus != null && _menus.Any())
            {
                @foreach (var menu in _menus)
                {
                    @RenderMenu(menu)
                }
            }
            else
            {
                @for (int i = 0; i < 4; i++)
                {
                    <span class="nav-skeleton me-2"></span>
                }
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="flex-grow-1"></div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<MenuDTO>? _menus;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask != null)
        {
            var state = await AuthenticationStateTask;
            if (state?.User?.Identity?.IsAuthenticated == true)
                await LoadMenuAsync();
        }
        AuthService.AuthenticationStateChanged += OnAuthenticationStateChanged;
        MenuService.ActiveMenuChanged += OnActiveMenuChanged;
    }

    private async Task LoadMenuAsync()
    {
        try
        {
            _menus = await MenuService.GetMenuTreeAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando menú: {ex.Message}");
            _menus = [];
            StateHasChanged();
        }
    }

    private async void OnAuthenticationStateChanged()
    {
        try
        {
            if (AuthenticationStateTask != null)
            {
                var state = await AuthenticationStateTask;
                if (state?.User?.Identity?.IsAuthenticated == true)
                {
                    await MenuService.InvalidateAsync();
                    _menus = await MenuService.GetMenuTreeAsync();
                }
                else
                {
                    _menus = null;
                    MenuService.ClearCache();
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en OnAuthenticationStateChanged: {ex.Message}");
        }
    }

    private void OnActiveMenuChanged() => StateHasChanged();

    public void Dispose()
    {
        AuthService.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        MenuService.ActiveMenuChanged -= OnActiveMenuChanged;
    }

    private RenderFragment RenderMenu(MenuDTO menu) => __builder =>
    {
        if (menu.Items != null && menu.Items.Any())
        {
            <div class="dropdown">
                <button class="btn btn-link text-white nav-menu-btn dropdown-toggle @(MenuService.ActiveLevel0 == menu ? "active" : "")"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    @(menu.Title)
                </button>
                <ul class="dropdown-menu">
                    @foreach (var sub in menu.Items)
                    {
                        var route = !string.IsNullOrEmpty(sub.Route)
                            ? sub.Route
                            : sub.Items?.FirstOrDefault(i => !string.IsNullOrEmpty(i.Route))?.Route ?? string.Empty;
                        <li>
                            <a class="dropdown-item nav-dropdown-item" href="@route">@(sub.Title)</a>
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <a class="btn btn-link text-white nav-menu-btn @(MenuService.ActiveLevel0 == menu ? "active" : "")" href="@menu.Route">
                @(menu.Title)
            </a>
        }
    };
}


