@inject MainMenuService MenuService
@inject NavigationManager NavManager
@implements IDisposable

@if (!string.IsNullOrEmpty(_requiredRole) && !_hasRole)
{
    <div class="alert alert-warning d-flex align-items-center mt-4" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-2 flex-shrink-0" viewBox="0 0 16 16">
            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
        </svg>
        No tienes permisos para acceder a esta sección.
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string? _requiredRole;
    private bool _hasRole = true;

    protected override async Task OnInitializedAsync()
    {
        MenuService.ActiveMenuChanged += OnMenuChanged;
        NavManager.LocationChanged += OnLocationChanged;
        await EvaluateAsync(NavManager.Uri);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await EvaluateAsync(e.Location);
        await InvokeAsync(StateHasChanged);
    }

    private void OnMenuChanged()
    {
        InvokeAsync(async () =>
        {
            await EvaluateAsync(NavManager.Uri);
            StateHasChanged();
        });
    }

    private async Task EvaluateAsync(string uri)
    {
        var path = new Uri(uri).AbsolutePath;
        _requiredRole = MenuService.GetRequiredRoleForRoute(path);

        if (!string.IsNullOrEmpty(_requiredRole) && AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            _hasRole = authState.User.IsInRole(_requiredRole);
        }
        else
        {
            _hasRole = true;
        }
    }

    public void Dispose()
    {
        MenuService.ActiveMenuChanged -= OnMenuChanged;
        NavManager.LocationChanged -= OnLocationChanged;
    }
}


