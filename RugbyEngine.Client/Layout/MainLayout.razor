@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject MainMenuService MenuService
@implements IDisposable

<!-- Topbar -->
<nav class="app-topbar flex items-center flex-nowrap">
    <div class="w-full flex items-center px-4">

        <!-- Hamburger: mobile -->
        <button class="btn btn-link text-white md:hidden mr-1 p-1"
                @onclick="ToggleLeftDrawer" aria-label="Menú">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"/>
            </svg>
        </button>

        <NavMenu />

        <!-- Account button -->
        <button class="btn btn-link text-white ml-auto p-1" @onclick="ToggleRightDrawer" aria-label="Cuenta">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.029 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
            </svg>
        </button>
    </div>
</nav>

<!-- Left drawer: mobile navigation -->
<div class="app-drawer-backdrop @(_leftDrawerOpen ? "app-drawer-backdrop--visible" : "")"
     @onclick="() => _leftDrawerOpen = false"></div>
<div class="app-drawer app-drawer--left @(_leftDrawerOpen ? "app-drawer--open" : "")">
    <div class="app-drawer__header">
        <span class="app-drawer__title">RugbyEngine</span>
        <button class="btn-close" @onclick="() => _leftDrawerOpen = false" aria-label="Cerrar"></button>
    </div>
    <MobileNavMenu />
</div>

<!-- Right drawer: account -->
<div class="app-drawer-backdrop @(_rightDrawerOpen ? "app-drawer-backdrop--visible" : "")"
     @onclick="() => _rightDrawerOpen = false"></div>
<div class="app-drawer app-drawer--right @(_rightDrawerOpen ? "app-drawer--open" : "")">
    <div class="app-drawer__header">
        <span class="app-drawer__title">Mi cuenta</span>
        <button class="btn-close" @onclick="() => _rightDrawerOpen = false" aria-label="Cerrar"></button>
    </div>
    <MobileUserDrawer />
</div>

<!-- Main content + optional side menu -->
<div class="app-body @(_hasSideMenu ? "app-body--with-side" : "")">
    <main class="app-main">
        <div class="app-content">
            <MenuRouteGuard>
                @Body
            </MenuRouteGuard>
        </div>
    </main>

    @if (_hasSideMenu)
    {
        <!-- Zona de swipe: borde derecho, solo mobile, solo cuando el panel está cerrado -->
        @if (!_mobileSideOpen)
        {
            <div class="app-swipe-zone md:hidden"
                 @ontouchstart="OnTouchStart"
                 @ontouchend="OnTouchEndOpen">
            </div>
        }

        <!-- Tab: solo mobile, visible cuando el panel está cerrado -->
        @if (!_mobileSideOpen)
        {
            <button class="app-side-tab md:hidden" @onclick="() => _mobileSideOpen = true" title="Abrir menú lateral">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
                </svg>
            </button>
        }

        <!-- Backdrop: solo mobile -->
        <div class="app-drawer-backdrop md:hidden @(_mobileSideOpen ? "app-drawer-backdrop--visible" : "")"
             @onclick="() => _mobileSideOpen = false"></div>

        <!-- Panel deslizable: solo mobile, con swipe-to-close -->
        <div class="app-sidemenu app-sidemenu--mobile md:hidden @(_mobileSideOpen ? "app-sidemenu--open" : "")"
             @ontouchstart="OnTouchStart"
             @ontouchend="OnTouchEndClose">
            <div class="app-drawer__header">
                <span class="app-drawer__title">Menú</span>
                <button class="btn-close" @onclick="() => _mobileSideOpen = false" aria-label="Cerrar"></button>
            </div>
            <MenuLateral />
        </div>

        <!-- Aside persistente: solo desktop -->
        <aside class="app-sidemenu app-sidemenu--desktop hidden md:flex flex-col">
            <MenuLateral />
        </aside>
    }
</div>

@code {
    private bool _leftDrawerOpen;
    private bool _rightDrawerOpen;
    private bool _mobileSideOpen;
    private bool _hasSideMenu;

    private double _touchStartX;
    private double _touchStartY;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        MenuService.ActiveMenuChanged += OnActiveMenuChanged;
    }

    // ── Swipe gestures ────────────────────────────────────────────────────────
    private void OnTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            _touchStartX = e.Touches[0].ClientX;
            _touchStartY = e.Touches[0].ClientY;
        }
    }

    private void OnTouchEndOpen(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length <= 0) return;
        var dx = e.ChangedTouches[0].ClientX - _touchStartX;
        var dy = e.ChangedTouches[0].ClientY - _touchStartY;
        if (Math.Abs(dx) > 40 && Math.Abs(dx) > Math.Abs(dy) && dx < 0)
        {
            _mobileSideOpen = true;
            StateHasChanged();
        }
    }

    private void OnTouchEndClose(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length <= 0) return;
        var dx = e.ChangedTouches[0].ClientX - _touchStartX;
        var dy = e.ChangedTouches[0].ClientY - _touchStartY;
        if (Math.Abs(dx) > 40 && Math.Abs(dx) > Math.Abs(dy) && dx > 0)
        {
            _mobileSideOpen = false;
            StateHasChanged();
        }
    }

    private void OnActiveMenuChanged()
    {
        _hasSideMenu = MenuService.ActiveLevel1 != null && MenuService.ActiveLevel1.Items.Any();
        if (!_hasSideMenu) _mobileSideOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleLeftDrawer() => _leftDrawerOpen = !_leftDrawerOpen;
    private void ToggleRightDrawer() => _rightDrawerOpen = !_rightDrawerOpen;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _leftDrawerOpen = false;
        _rightDrawerOpen = false;
        _mobileSideOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        MenuService.ActiveMenuChanged -= OnActiveMenuChanged;
    }
}


