@using MudBlazor
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@implements IDisposable

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="4" Color="Color.Primary">
        <MudHidden Breakpoint="Breakpoint.SmAndUp">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="ToggleLeftDrawer" />
        </MudHidden>
        <NavMenu />
        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                       Color="Color.Inherit"
                       Edge="Edge.End"
                       OnClick="ToggleRightDrawer" />
    </MudAppBar>

    <MudDrawer @bind-Open="_leftDrawerOpen"
               Anchor="Anchor.Left"
               Elevation="2"
               Variant="DrawerVariant.Temporary"
               ClipMode="DrawerClipMode.Never">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">RugbyEngine</MudText>
        </MudDrawerHeader>
        <MobileNavMenu />
    </MudDrawer>

    <MudDrawer @bind-Open="_rightDrawerOpen"
               Anchor="Anchor.Right"
               Elevation="2"
               Variant="DrawerVariant.Temporary"
               ClipMode="DrawerClipMode.Never">
        <MobileUserDrawer />
    </MudDrawer>

    <MudMainContent Class="mt-16 pa-4" Style="background-color: var(--mud-palette-background-gray);">
        <MudContainer MaxWidth="MaxWidth.Large">
            <MenuRouteGuard>
                @Body
            </MenuRouteGuard>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _leftDrawerOpen;
    private bool _rightDrawerOpen;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void ToggleLeftDrawer() => _leftDrawerOpen = !_leftDrawerOpen;
    private void ToggleRightDrawer() => _rightDrawerOpen = !_rightDrawerOpen;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _leftDrawerOpen = false;
        _rightDrawerOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1976D2",
            Secondary = "#FF4081",
            AppbarBackground = "#1976D2",
            Background = "#f5f5f5",
            Surface = "#ffffff",
            DrawerBackground = "#ffffff",
            DrawerText = "rgba(0,0,0,0.87)",
            AppbarText = "#ffffff"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Roboto", "Helvetica", "Arial", "sans-serif"]
            }
        }
    };
}
