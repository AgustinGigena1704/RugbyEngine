@page "/"
@attribute [Authorize]

<PageTitle>Inicio</PageTitle>

<AuthorizeView>
    <Authorized Context="authContext">
        <h1>Bienvenido!</h1>
    </Authorized>
    <NotAuthorized>
        <p>Validando sesión...</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    

    private static IEnumerable<string> GetRoles(ClaimsPrincipal user)
    {
        return user.FindAll(ClaimTypes.Role).Select(claim => claim.Value).Distinct();
    }

    private static bool HasRoles(ClaimsPrincipal user)
    {
        return user.Claims.Any(claim => claim.Type == ClaimTypes.Role);
    }
}
