@page "/"
@attribute [Authorize]
@using System.Security.Claims

<PageTitle>Inicio</PageTitle>

<AuthorizeView>
    <Authorized Context="authContext">
        <div class="page-hero mb-4">
            <div class="page-hero__icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M2.5.5A.5.5 0 0 1 3 0h10a.5.5 0 0 1 .5.5c0 .538-.012 1.05-.034 1.536a3 3 0 1 1-1.133 5.89c-.79 1.865-1.878 2.777-2.833 3.011v2.173l1.425.356c.194.048.377.135.537.255L13.3 15.1a.5.5 0 0 1-.3.9H3a.5.5 0 0 1-.3-.9l1.838-1.379c.16-.12.343-.207.537-.255L6.5 13.11v-2.173c-.955-.234-2.043-1.146-2.833-3.012a3 3 0 1 1-1.132-5.89A33 33 0 0 1 2.5.5m.099 2.54a2 2 0 0 0 .72 3.935c-.333-1.05-.588-2.346-.72-3.935m10.083 3.935a2 2 0 0 0 .72-3.935c-.133 1.59-.388 2.885-.72 3.935M3.504 1c.007.517.026 1.006.056 1.469.13 2.028.457 3.546.87 4.667C5.294 9.48 6.484 10 7 10a.5.5 0 0 1 .5.5v2.61a1 1 0 0 1-.757.97l-1.426.356-.48.36H10.163l-.48-.36-1.426-.356a1 1 0 0 1-.757-.97V10.5A.5.5 0 0 1 8 10c.516 0 1.706-.52 2.57-2.864.413-1.12.74-2.64.87-4.667.03-.463.049-.952.056-1.469z"/>
                </svg>
            </div>
            <div>
                <h2 class="page-hero__title">¡Bienvenido, @GetDisplayName(authContext.User)!</h2>
                <p class="page-hero__subtitle mb-0">RugbyEngine — Panel de gestión</p>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="loading-ball">
            <img src="images/loadingPelota.svg" alt="Validando sesión..." />
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string GetDisplayName(ClaimsPrincipal user)
        => user.FindFirst("username")?.Value ?? user.Identity?.Name ?? "Usuario";
}
