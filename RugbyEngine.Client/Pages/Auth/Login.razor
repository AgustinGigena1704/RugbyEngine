@page "/Auth/Login"
@attribute [AllowAnonymous]
@layout LoginLayout

@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Iniciar sesión</PageTitle>

<div class="login-card">
    <h1 class="login-card__brand">RugbyEngine</h1>
    <p class="login-card__subtitle">Inicia sesión para continuar</p>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert @(_statusIsError ? "alert-danger" : "alert-success") py-2" role="alert">
            @_statusMessage
        </div>
    }

    <EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="username" class="form-label">Usuario</label>
            <InputText id="username"
                       class="form-control"
                       @bind-Value="_model.Username"
                       placeholder="Ingresa tu usuario"
                       autocomplete="username" />
            <ValidationMessage For="@(() => _model.Username)" class="text-danger small" />
        </div>

        <div class="mb-4">
            <label for="password" class="form-label">Contraseña</label>
            <InputText id="password"
                       type="password"
                       class="form-control"
                       @bind-Value="_model.Password"
                       placeholder="Ingresa tu contraseña"
                       autocomplete="current-password" />
            <ValidationMessage For="@(() => _model.Password)" class="text-danger small" />
        </div>

        <button type="submit" class="btn btn-primary w-100" disabled="@_isSubmitting">
            @if (_isSubmitting)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Ingresando...</span>
            }
            else
            {
                <span>Ingresar</span>
            }
        </button>
    </EditForm>
</div>

@code {
    private readonly LoginDTO _model = new();
    private bool _isSubmitting;
    private string? _statusMessage;
    private bool _statusIsError = true;
    private string? _returnUrl;

    protected override async Task OnInitializedAsync()
    {
        _returnUrl = ExtractReturnUrl();
        if (await AuthService.IsAuthenticatedAsync())
            NavigationManager.NavigateTo(_returnUrl ?? "/", true);
    }

    private async Task HandleLoginAsync()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        _statusMessage = null;
        StateHasChanged();

        var response = await AuthService.LoginAsync(_model);

        if (response.Success)
        {
            _isSubmitting = false;
            NavigationManager.NavigateTo(_returnUrl ?? "/", true);
            return;
        }

        _statusIsError = true;
        _statusMessage = string.IsNullOrWhiteSpace(response.Message)
            ? "No se pudo iniciar sesión."
            : response.Message;
        _isSubmitting = false;
    }

    private string? ExtractReturnUrl()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (string.IsNullOrEmpty(uri.Query)) return null;

        foreach (var parameter in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = parameter.Split('=', 2);
            if (parts.Length == 2 && parts[0].Equals("returnUrl", StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(parts[1]);
        }
        return null;
    }
}


