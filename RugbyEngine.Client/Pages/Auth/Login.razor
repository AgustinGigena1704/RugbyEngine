@page "/Auth/Login"
@attribute [AllowAnonymous]
@layout LoginLayout

@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Iniciar sesión</PageTitle>

<div class="login-card">
    <h1 class="login-card__brand">RugbyEngine</h1>
    <p class="login-card__subtitle">Inicia sesión para continuar</p>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert @(_statusIsError ? "alert-danger" : "alert-success") py-2" role="alert">
            @_statusMessage
        </div>
    }

    <EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
        <DataAnnotationsValidator />

        <div class="mb-4">
            <label for="username" class="form-label">Usuario</label>
            <InputText id="username"
                       class="form-control"
                       @bind-Value="_model.Username"
                       placeholder="Ingresa tu usuario"
                       autocomplete="username" />
            <ValidationMessage For="@(() => _model.Username)" class="text-red-600 text-sm" />
        </div>

        <div class="mb-6">
            <label for="password" class="form-label">Contraseña</label>
            <div class="login-password-wrapper">
                <InputText id="password"
                           type="@(_showPassword ? "text" : "password")"
                           class="form-control"
                           @bind-Value="_model.Password"
                           placeholder="Ingresa tu contraseña"
                           autocomplete="current-password" />
                <button type="button" class="login-password-toggle" tabindex="-1"
                        @onclick="() => _showPassword = !_showPassword"
                        aria-label="@(_showPassword ? "Ocultar contraseña" : "Mostrar contraseña")">
                    @if (_showPassword)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z"/>
                            <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829"/>
                            <path d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12z"/>
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                        </svg>
                    }
                </button>
            </div>
            <ValidationMessage For="@(() => _model.Password)" class="text-red-600 text-sm" />
        </div>

        <button type="submit" class="btn btn-primary w-full" disabled="@_isSubmitting">
            @if (_isSubmitting)
            {
                <span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>
                <span>Ingresando...</span>
            }
            else
            {
                <span>Ingresar</span>
            }
        </button>
    </EditForm>
</div>

@code {
    private readonly LoginDTO _model = new();
    private bool _isSubmitting;
    private bool _showPassword;
    private string? _statusMessage;
    private bool _statusIsError = true;
    private string? _returnUrl;

    protected override async Task OnInitializedAsync()
    {
        _returnUrl = ExtractReturnUrl();
        if (await AuthService.IsAuthenticatedAsync())
            NavigationManager.NavigateTo(_returnUrl ?? "/", true);
    }

    private async Task HandleLoginAsync()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        _statusMessage = null;
        StateHasChanged();

        var response = await AuthService.LoginAsync(_model);

        if (response.Success)
        {
            _isSubmitting = false;
            NavigationManager.NavigateTo(_returnUrl ?? "/", true);
            return;
        }

        _statusIsError = true;
        _statusMessage = string.IsNullOrWhiteSpace(response.Message)
            ? "No se pudo iniciar sesión."
            : response.Message;
        _isSubmitting = false;
    }

    private string? ExtractReturnUrl()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (string.IsNullOrEmpty(uri.Query)) return null;

        foreach (var parameter in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = parameter.Split('=', 2);
            if (parts.Length == 2 && parts[0].Equals("returnUrl", StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(parts[1]);
        }
        return null;
    }
}


