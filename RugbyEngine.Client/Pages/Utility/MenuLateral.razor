@inject MainMenuService MenuService
@inject NavigationManager NavigationManager
@implements IDisposable

<div style="display: flex; flex-direction: column; padding-top: 8px;">

    <div style="padding: 0 8px 8px;">
        <MudAutocomplete T="MenuDTO"
                         Placeholder="Buscar opciones..."
                         SearchFunc="SearchItems"
                         ToStringFunc="@(item => item?.Title ?? string.Empty)"
                         Value="_selectedItem"
                         ValueChanged="OnItemSelected"
                         Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         FullWidth="true"
                         Clearable="true"
                         ResetValueOnEmptyText="true"
                         CoerceText="false"
                         CoerceValue="false" />
    </div>

    <MudDivider />

    <div style="padding: 4px 0;">
        @if (_isLoading)
        {
            <div style="padding: 8px;">
                @for (int i = 0; i < 6; i++)
                {
                    <MudSkeleton Width="100%" Height="36px" Class="mb-1" />
                }
            </div>
        }
        else if (_allLevel2Items.Any())
        {
            <MudNavMenu>
                @foreach (var item in _allLevel2Items)
                {
                    <MudNavLink Href="@item.Route"
                                Icon="@(!string.IsNullOrEmpty(item.Icon) ? item.Icon : string.Empty)"
                                Match="NavLinkMatch.All">
                        <span style="text-transform: uppercase; font-weight: bold; font-size: 0.85rem;">@item.Title</span>
                    </MudNavLink>
                }
            </MudNavMenu>
        }
        else
        {
            <div style="padding: 16px; text-align: center;">
                <MudText Typo="Typo.body2" Color="Color.Secondary">No se encontraron opciones.</MudText>
            </div>
        }
    </div>

</div>

@code {
    [Parameter]
    public MenuDTO? ParentMenu { get; set; }

    private bool _isLoading = false;
    private MenuDTO? _selectedItem;
    private List<MenuDTO> _allLevel2Items = new();
    private MenuDTO? _previousParentMenu;
    private bool _firstLoad = true;

    private Task<IEnumerable<MenuDTO>> SearchItems(string text, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult(_allLevel2Items.AsEnumerable());

        var filtered = _allLevel2Items
            .Where(m => m.Title.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                        (m.ToolTip != null && m.ToolTip.Contains(text, StringComparison.OrdinalIgnoreCase)));
        return Task.FromResult(filtered);
    }

    private void OnItemSelected(MenuDTO? item)
    {
        if (item?.Route is not null)
        {
            NavigationManager.NavigateTo(item.Route);
        }
        _selectedItem = null;
    }

    protected override async Task OnInitializedAsync()
    {
        MenuService.ActiveMenuChanged += OnActiveMenuChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_firstLoad || _previousParentMenu != ParentMenu)
        {
            _firstLoad = false;
            _previousParentMenu = ParentMenu;
            await LoadItemsAsync();
        }
    }

    private void OnActiveMenuChanged()
    {
        if (ParentMenu == null)
        {
            _allLevel2Items = MenuService.ActiveLevel1?.Items ?? new();
            _selectedItem = null;
            StateHasChanged();
        }
    }

    private async Task LoadItemsAsync()
    {
        _isLoading = true;
        _allLevel2Items = new();
        StateHasChanged();

        try
        {
            if (ParentMenu != null)
            {
                _allLevel2Items = ParentMenu.Items ?? new();
            }
            else
            {
                await MenuService.GetMenuTreeAsync();

                if (MenuService.ActiveLevel1 != null)
                {
                    _allLevel2Items = MenuService.ActiveLevel1.Items;
                }
                else
                {
                    foreach (var level0 in await MenuService.GetMenuTreeAsync())
                        foreach (var level1 in level0.Items)
                            _allLevel2Items.AddRange(level1.Items);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando menú lateral: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        MenuService.ActiveMenuChanged -= OnActiveMenuChanged;
    }
}