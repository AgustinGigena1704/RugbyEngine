@inject MainMenuService MenuService
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="side-menu">
    <div class="side-menu__search">
        <input type="search" class="form-control form-control-sm"
               placeholder="Buscar opciones..."
               @bind="_searchText" @bind:event="oninput" />
    </div>

    <hr class="my-2" />

    @if (_isLoading)
    {
        <Loading Contained="true"/>
    }
    else if (FilteredItems.Any())
    {
        <nav class="side-menu__nav">
            @foreach (var item in FilteredItems)
            {
                var route = ResolveRoute(item);
                if (!string.IsNullOrWhiteSpace(route))
                {
                    <a class="side-menu__link @(IsActiveRoute(route) ? "side-menu__link--active" : "")"
                       href="@route">
                        @item.Title
                    </a>
                }
            }
        </nav>
    }
    else
    {
        <p class="text-gray-500 text-sm text-center px-3 py-2">No se encontraron opciones.</p>
    }
</div>

@code {
    [Parameter]
    public MenuDto? ParentMenu { get; set; }

    private bool _isLoading;
    private List<MenuDto> _allLevel2Items = new();
    private MenuDto? _previousParentMenu;
    private bool _firstLoad = true;
    private string _searchText = string.Empty;

    private IEnumerable<MenuDto> FilteredItems => string.IsNullOrWhiteSpace(_searchText)
        ? _allLevel2Items
        : _allLevel2Items.Where(m =>
            m.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            (m.ToolTip != null && m.ToolTip.Contains(_searchText, StringComparison.OrdinalIgnoreCase)));

    private static string ResolveRoute(MenuDto item)
    {
        if (item.Items is { Count: > 0 })
        {
            var firstChildRoute = item.Items
                .Select(ResolveRoute)
                .FirstOrDefault(route => !string.IsNullOrWhiteSpace(route));

            if (!string.IsNullOrWhiteSpace(firstChildRoute))
                return firstChildRoute;
        }

        return item.Route ?? string.Empty;
    }

    private bool IsActiveRoute(string route)
    {
        var currentPath = new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        var normalizedRoute = "/" + route.Trim('/').ToLowerInvariant();
        return currentPath == normalizedRoute || currentPath.StartsWith(normalizedRoute + "/", StringComparison.Ordinal);
    }

    protected override async Task OnInitializedAsync()
    {
        MenuService.ActiveMenuChanged += OnActiveMenuChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_firstLoad || _previousParentMenu != ParentMenu)
        {
            _firstLoad = false;
            _previousParentMenu = ParentMenu;
            await LoadItemsAsync();
        }
    }

    private void OnActiveMenuChanged()
    {
        if (ParentMenu == null)
        {
            _allLevel2Items = MenuService.ActiveLevel1?.Items ?? new();
            _searchText = string.Empty;
            StateHasChanged();
        }
    }

    private async Task LoadItemsAsync()
    {
        _isLoading = true;
        _allLevel2Items = new();
        StateHasChanged();

        try
        {
            if (ParentMenu != null)
            {
                _allLevel2Items = ParentMenu.Items ?? new();
            }
            else
            {
                await MenuService.GetMenuTreeAsync();

                if (MenuService.ActiveLevel1 != null)
                {
                    _allLevel2Items = MenuService.ActiveLevel1.Items;
                }
                else
                {
                    // No hay ActiveLevel1 -> no mostrar elementos laterales
                    _allLevel2Items = new();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando menú lateral: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        MenuService.ActiveMenuChanged -= OnActiveMenuChanged;
    }
}
