@inject MainMenuService MenuService
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="side-menu">
    <div class="side-menu__search">
        <input type="search" class="form-control form-control-sm"
               placeholder="Buscar opciones..."
               @bind="_searchText" @bind:event="oninput" />
    </div>

    <hr class="my-2" />

    @if (_isLoading)
    {
        <div class="loading-ball loading-ball--sm">
            <img src="images/loadingPelota.svg" alt="Cargando..." />
        </div>
    }
    else if (FilteredItems.Any())
    {
        <nav class="side-menu__nav">
            @foreach (var item in FilteredItems)
            {
                <a class="side-menu__link @(NavigationManager.Uri.Contains(item.Route ?? string.Empty) && !string.IsNullOrEmpty(item.Route) ? "side-menu__link--active" : "")"
                   href="@item.Route">
                    @item.Title
                </a>
            }
        </nav>
    }
    else
    {
        <p class="text-muted small text-center px-3 py-2">No se encontraron opciones.</p>
    }
</div>

@code {
    [Parameter]
    public MenuDTO? ParentMenu { get; set; }

    private bool _isLoading;
    private List<MenuDTO> _allLevel2Items = new();
    private MenuDTO? _previousParentMenu;
    private bool _firstLoad = true;
    private string _searchText = string.Empty;

    private IEnumerable<MenuDTO> FilteredItems => string.IsNullOrWhiteSpace(_searchText)
        ? _allLevel2Items
        : _allLevel2Items.Where(m =>
            m.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            (m.ToolTip != null && m.ToolTip.Contains(_searchText, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        MenuService.ActiveMenuChanged += OnActiveMenuChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_firstLoad || _previousParentMenu != ParentMenu)
        {
            _firstLoad = false;
            _previousParentMenu = ParentMenu;
            await LoadItemsAsync();
        }
    }

    private void OnActiveMenuChanged()
    {
        if (ParentMenu == null)
        {
            _allLevel2Items = MenuService.ActiveLevel1?.Items ?? new();
            _searchText = string.Empty;
            StateHasChanged();
        }
    }

    private async Task LoadItemsAsync()
    {
        _isLoading = true;
        _allLevel2Items = new();
        StateHasChanged();

        try
        {
            if (ParentMenu != null)
            {
                _allLevel2Items = ParentMenu.Items ?? new();
            }
            else
            {
                await MenuService.GetMenuTreeAsync();

                if (MenuService.ActiveLevel1 != null)
                {
                    _allLevel2Items = MenuService.ActiveLevel1.Items;
                }
                else
                {
                    foreach (var level0 in await MenuService.GetMenuTreeAsync())
                        foreach (var level1 in level0.Items)
                            _allLevel2Items.AddRange(level1.Items);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando menú lateral: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        MenuService.ActiveMenuChanged -= OnActiveMenuChanged;
    }
}
