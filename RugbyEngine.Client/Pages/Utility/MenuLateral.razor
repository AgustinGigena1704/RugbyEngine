@inject MainMenuService MenuService
@implements IDisposable

<MudPaper Elevation="2"
          Style="position: fixed; left: 0; top: 64px; bottom: 0; width: 260px; display: flex; flex-direction: column; z-index: 999; border-right: 1px solid var(--mud-palette-divider); background-color: var(--mud-palette-surface);">

    <div style="padding: 8px;">
        <MudTextField @bind-Value="_searchText"
                      Placeholder="Buscar opciones..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      FullWidth="true"
                      Immediate="true"
                      Clearable="true" />
    </div>

    <MudDivider />

    <div style="overflow-y: auto; flex: 1; padding: 4px 0;">
        @if (_isLoading)
        {
            <div style="padding: 8px;">
                @for (int i = 0; i < 6; i++)
                {
                    <MudSkeleton Width="100%" Height="36px" Class="mb-1" />
                }
            </div>
        }
        else if (_filteredItems.Any())
        {
            <MudNavMenu>
                @foreach (var item in _filteredItems)
                {
                    <MudNavLink Href="@item.Route"
                                Icon="@(!string.IsNullOrEmpty(item.Icon) ? item.Icon : Icons.Material.Filled.ChevronRight)"
                                Match="NavLinkMatch.All">
                        @item.Title
                    </MudNavLink>
                }
            </MudNavMenu>
        }
        else
        {
            <div style="padding: 16px; text-align: center;">
                <MudText Typo="Typo.body2" Color="Color.Secondary">No se encontraron opciones.</MudText>
            </div>
        }
    </div>
</MudPaper>

@code {
    [Parameter]
    public MenuDTO? ParentMenu { get; set; }

    private bool _isLoading = false;
    private string _searchText = string.Empty;
    private List<MenuDTO> _allLevel2Items = new();
    private MenuDTO? _previousParentMenu;
    private bool _firstLoad = true;

    private List<MenuDTO> _filteredItems =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _allLevel2Items
            : _allLevel2Items
                .Where(m => m.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                            m.ToolTip.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        MenuService.ActiveMenuChanged += OnActiveMenuChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_firstLoad || _previousParentMenu != ParentMenu)
        {
            _firstLoad = false;
            _previousParentMenu = ParentMenu;
            await LoadItemsAsync();
        }
    }

    private void OnActiveMenuChanged()
    {
        // Cuando la ruta cambia y no hay ParentMenu explícito, usar el ActiveLevel1 del servicio
        if (ParentMenu == null)
        {
            _allLevel2Items = MenuService.ActiveLevel1?.Items ?? new();
            _searchText = string.Empty;
            StateHasChanged();
        }
    }

    private async Task LoadItemsAsync()
    {
        _isLoading = true;
        _allLevel2Items = new();
        StateHasChanged();

        try
        {
            if (ParentMenu != null)
            {
                _allLevel2Items = ParentMenu.Items ?? new();
            }
            else
            {
                // Usar el ActiveLevel1 del servicio si ya está resuelto;
                // si no, cargar el árbol completo y usar el nivel activo (o todos si aún no hay ruta activa).
                await MenuService.GetMenuTreeAsync();

                if (MenuService.ActiveLevel1 != null)
                {
                    _allLevel2Items = MenuService.ActiveLevel1.Items;
                }
                else
                {
                    foreach (var level0 in await MenuService.GetMenuTreeAsync())
                        foreach (var level1 in level0.Items)
                            _allLevel2Items.AddRange(level1.Items);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando menú lateral: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        MenuService.ActiveMenuChanged -= OnActiveMenuChanged;
    }
}