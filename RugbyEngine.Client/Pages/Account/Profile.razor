@page "/account/profile"
@attribute [Authorize]
@using RugbyEngine.Shared.Perfiles
@using System.Security.Claims
@inject IPerfilService PerfilService
@inject AuthenticationStateProvider AuthStateProvider
@inject INotificationService Notifier

<PageTitle>Mi Perfil</PageTitle>

<h4 class="mb-6 font-bold">Mi Perfil</h4>

<AuthorizeView>
    <Authorized Context="authContext">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Avatar -->
            <div>
                <div class="card shadow-sm h-full">
                    <div class="card-body flex flex-col items-center justify-center py-6">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="var(--app-primary)" viewBox="0 0 16 16">
                            <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.029 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
                        </svg>
                        <h5 class="mt-4 mb-0">@GetDisplayName(authContext.User)</h5>
                    </div>
                </div>
            </div>

            <!-- Perfiles -->
            <div class="md:col-span-2">
                <div class="card shadow-sm h-full">
                    <div class="card-body">
                        @if (_loading)
                        {
                            <Loading Contained="true"/>
                        }
                        else
                        {
                            <div class="flex items-center justify-between mb-4">
                                <h5 class="mb-0 font-bold">Mis perfiles</h5>
                                <AuthorizeView Roles="admin">
                                    <NotAuthorized>
                                        <span class="badge bg-secondary">Solo lectura</span>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>

                            @if (_mine.Count == 0)
                            {
                                <p class="text-gray-500 text-sm mb-6">Sin perfiles asignados.</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush mb-3">
                                    @foreach (var p in _mine)
                                    {
                                        <li class="list-group-item flex items-center justify-between px-0">
                                            <div>
                                                <span class="font-semibold">@p.Nombre</span>
                                                @if (!string.IsNullOrEmpty(p.Descripcion))
                                                {
                                                    <br /><span class="text-gray-500 text-sm">@p.Descripcion</span>
                                                }
                                            </div>
                                            <AuthorizeView Roles="admin">
                                                <Authorized>
                                                    <button class="btn btn-sm btn-outline-danger" disabled="@_busy"
                                                            @onclick="() => RemoveAsync(p)" title="Retirar">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                                            <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8"/>
                                                        </svg>
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                        </li>
                                    }
                                </ul>
                            }

                            <AuthorizeView Roles="admin">
                                <Authorized>
                                    <hr />
                                    <h6 class="font-bold mb-2">Perfiles disponibles</h6>
                                    @if (_available.Count == 0)
                                    {
                                        <p class="text-gray-500 text-sm">No hay perfiles disponibles para agregar.</p>
                                    }
                                    else
                                    {
                                        <ul class="list-group list-group-flush">
                                            @foreach (var p in _available)
                                            {
                                                <li class="list-group-item flex items-center justify-between px-0">
                                                    <div>
                                                        <span class="font-semibold">@p.Nombre</span>
                                                        @if (!string.IsNullOrEmpty(p.Descripcion))
                                                        {
                                                            <br /><span class="text-gray-500 text-sm">@p.Descripcion</span>
                                                        }
                                                    </div>
                                                    <button class="btn btn-sm btn-outline-success" disabled="@_busy"
                                                            @onclick="() => AssignAsync(p)" title="Agregar">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                                            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                                                        </svg>
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </Authorized>
                            </AuthorizeView>
                        }
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private List<PerfilDto> _all = [];
    private List<PerfilDto> _mine = [];
    private List<PerfilDto> _available = [];
    private bool _loading = true;
    private bool _busy;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("admin");
        _mine = await PerfilService.GetMineAsync();
        if (_isAdmin)
        {
            _all = await PerfilService.GetAllAsync();
            _available = _all.Where(p => _mine.All(m => m.Id != p.Id)).ToList();
        }
        _loading = false;
    }

    private async Task AssignAsync(PerfilDto perfil)
    {
        if (!_isAdmin) return;
        _busy = true;
        var ok = await PerfilService.AssignAsync(perfil.Id);
        if (ok) { _mine.Add(perfil); _available.Remove(perfil); Notifier.Notify(NotificationType.Ok, $"Perfil \"{perfil.Nombre}\" agregado."); }
        else Notifier.Notify(NotificationType.Error, $"No se pudo agregar el perfil \"{perfil.Nombre}\".");
        _busy = false;
    }

    private async Task RemoveAsync(PerfilDto perfil)
    {
        if (!_isAdmin) return;
        _busy = true;
        var ok = await PerfilService.UnassignAsync(perfil.Id);
        if (ok) { _mine.Remove(perfil); _available.Add(perfil); Notifier.Notify(NotificationType.Ok, $"Perfil \"{perfil.Nombre}\" retirado."); }
        else Notifier.Notify(NotificationType.Error, $"No se pudo retirar el perfil \"{perfil.Nombre}\".");
        _busy = false;
    }

    private static string GetDisplayName(ClaimsPrincipal user)
        => user.FindFirst("username")?.Value ?? user.Identity?.Name ?? "Usuario";
}


