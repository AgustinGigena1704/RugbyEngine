@page "/Admin/Registro/Usuarios"
@attribute [Authorize(Roles = "admin")]
@using RugbyEngine.Shared.Usuarios
@using RugbyEngine.Shared.Perfiles
@using RugbyEngine.Shared.Personas
@using RugbyEngine.Shared.Tablas

@inject IUsuarioService UsuarioService
@inject IPerfilService PerfilService
@inject IPersonaService PersonaService

<PageTitle>Usuarios</PageTitle>

@if (_toast is not null)
{
    <div class="app-toast @(_toastIsError ? "app-toast--error" : "app-toast--success")" role="alert">
        @_toast
    </div>
}

<div class="flex items-center justify-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0 font-bold">Gestión de Usuarios</h4>
    <button class="btn btn-primary btn-action" @onclick="OpenCreateDialog">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="mr-1" viewBox="0 0 16 16">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
        </svg>
        Nuevo Usuario
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <div class="mb-4">
            <input type="search" class="form-control" placeholder="Buscar por usuario, nombre o documento..."
                   value="@_searchText" @oninput="OnSearchInput" />
        </div>

        <Tabla T="UsuarioResponse"
               @ref="_tablaRef"
               Paginacion="true"
               SearchFunc="SearchUsuariosAsync"
               CountFunc="CountUsuariosAsync"
               PageSizes="_pageSizes"
               EmptyText="No se encontraron usuarios.">
            <Header>
                <Columna Nombre="Usuario" />
                <Columna Nombre="Nombre" />
                <Columna Nombre="Documento" />
                <Columna Nombre="Email" />
                <Columna Nombre="Perfiles" />
                <Columna Nombre="Último acceso" />
                <Columna Nombre="Estado" />
                <Columna Nombre="Acciones" />
            </Header>
            <Rows>
                <Row T="UsuarioResponse" Context="u"><span class="font-semibold">@u.Username</span></Row>
                <Row T="UsuarioResponse" Context="u">@u.NombreCompleto</Row>
                <Row T="UsuarioResponse" Context="u">@u.Documento</Row>
                <Row T="UsuarioResponse" Context="u">@(string.IsNullOrEmpty(u.Email) ? "-" : u.Email)</Row>
                <Row T="UsuarioResponse" Context="u">
                    @if (u.Perfiles.Count == 0)
                    {
                        <span class="text-gray-500 text-sm">Sin perfiles</span>
                    }
                    else
                    {
                        @foreach (var p in u.Perfiles.Take(2))
                        {
                            <span class="badge bg-primary mr-1">@p.Nombre</span>
                        }
                        @if (u.Perfiles.Count > 2)
                        {
                            <span class="badge bg-secondary">+@(u.Perfiles.Count - 2)</span>
                        }
                    }
                </Row>
                <Row T="UsuarioResponse" Context="u"><span class="text-sm text-gray-500">@u.LastLogin.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></Row>
                <Row T="UsuarioResponse" Context="u">
                    @if (u.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </Row>
                <Row T="UsuarioResponse" Context="u">
                    <div class="td-actions">
                        <button class="btn btn-sm btn-outline-primary btn-action mr-1" title="Editar" @onclick="() => OpenEditDialog(u)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.499.499 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                            </svg>
                            <span class="hidden lg:inline ml-1">Editar</span>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary btn-action mr-1" title="Perfiles" @onclick="() => OpenPerfilesDialog(u)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13.5c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/>
                            </svg>
                            <span class="hidden lg:inline ml-1">Perfiles</span>
                        </button>
                        <button class="btn btn-sm btn-outline-danger btn-action" title="Eliminar" @onclick="() => ConfirmDelete(u)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                            </svg>
                            <span class="hidden lg:inline ml-1">Eliminar</span>
                        </button>
                    </div>
                </Row>
            </Rows>
        </Tabla>
    </div>
</div>

<!-- Modal: Nuevo usuario -->
@if (_createDialogVisible)
{
    <div class="app-modal-backdrop" @onclick="CloseCreateDialog"></div>
    <div class="app-modal" role="dialog" aria-modal="true">
        <div class="app-modal__header">
            <h5 class="app-modal__title">Nuevo Usuario</h5>
            <button class="btn-close" @onclick="CloseCreateDialog" aria-label="Cerrar"></button>
        </div>
        <div class="app-modal__body">
            <EditForm Model="_createModel" OnValidSubmit="SaveCreateAsync">
                <DataAnnotationsValidator />
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="form-label">Nombre de usuario <span class="text-red-600">*</span></label>
                        <InputText class="form-control" @bind-Value="_createModel.Username" autocomplete="off" />
                        <ValidationMessage For="@(() => _createModel.Username)" class="text-red-600 text-sm" />
                    </div>
                    <div>
                        <label class="form-label">Contraseña <span class="text-red-600">*</span></label>
                        <InputText type="password" class="form-control" @bind-Value="_createModel.Password" autocomplete="new-password" />
                        <ValidationMessage For="@(() => _createModel.Password)" class="text-red-600 text-sm" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="form-label">Email</label>
                        <InputText type="email" class="form-control" @bind-Value="_createModel.Email" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="form-label">Persona vinculada <span class="text-red-600">*</span></label>
                        <input type="text" class="form-control" list="personas-list"
                               @bind="_personaSearchText" @bind:event="oninput"
                               placeholder="Buscar por apellido, nombre o documento..." />
                        <datalist id="personas-list">
                            @foreach (var p in _todasPersonas)
                            {
                                <option value="@($"{p.Apellidos}, {p.Nombres} — {p.Documento}")" />
                            }
                        </datalist>
                        @if (_selectedPersona is not null)
                        {
                            <div class="mt-1 text-sm text-green-600">
                                Seleccionado: <strong>@_selectedPersona.Apellidos, @_selectedPersona.Nombres</strong>
                            </div>
                        }
                    </div>
                </div>
                <div class="app-modal__footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseCreateDialog" disabled="@_isSaving">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-action" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
                        }
                        Guardar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Modal: Editar usuario -->
@if (_editDialogVisible)
{
    <div class="app-modal-backdrop" @onclick="CloseEditDialog"></div>
    <div class="app-modal" role="dialog" aria-modal="true">
        <div class="app-modal__header">
            <h5 class="app-modal__title">Editar Usuario — @_editingUsuario?.Username</h5>
            <button class="btn-close" @onclick="CloseEditDialog" aria-label="Cerrar"></button>
        </div>
        <div class="app-modal__body">
            <EditForm Model="_editModel" OnValidSubmit="SaveEditAsync">
                <DataAnnotationsValidator />
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="form-label">Nombre de usuario <span class="text-red-600">*</span></label>
                        <InputText class="form-control" @bind-Value="_editModel.Username" />
                        <ValidationMessage For="@(() => _editModel.Username)" class="text-red-600 text-sm" />
                    </div>
                    <div>
                        <label class="form-label">Email</label>
                        <InputText type="email" class="form-control" @bind-Value="_editModel.Email" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="form-label">Nueva contraseña (opcional)</label>
                        <InputText type="password" class="form-control" @bind-Value="_editModel.Password" autocomplete="new-password" />
                    </div>
                </div>
                <div class="app-modal__footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEditDialog" disabled="@_isSaving">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-action" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
                        }
                        Guardar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Modal: Gestión de perfiles -->
@if (_perfilesDialogVisible)
{
    <div class="app-modal-backdrop" @onclick="() => _perfilesDialogVisible = false"></div>
    <div class="app-modal" role="dialog" aria-modal="true">
        <div class="app-modal__header">
            <h5 class="app-modal__title">Perfiles — @_perfilesUsuario?.Username</h5>
            <button class="btn-close" @onclick="() => _perfilesDialogVisible = false" aria-label="Cerrar"></button>
        </div>
        <div class="app-modal__body">
            @if (_perfilesLoading)
            {
                <div class="loading-ball loading-ball--sm">
                    <img src="images/loadingPelota.svg" alt="Cargando perfiles..." />
                </div>
            }
            else
            {
                <p class="font-semibold text-sm mb-1">Perfiles asignados</p>
                @if (_perfilesAsignados.Count == 0)
                {
                    <p class="text-gray-500 text-sm mb-4">Sin perfiles asignados.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var p in _perfilesAsignados)
                        {
                            <li class="list-group-item flex items-center justify-between px-0">
                                <div>
                                    <span class="font-semibold">@p.Nombre</span>
                                    @if (!string.IsNullOrEmpty(p.Descripcion))
                                    {
                                        <br /><span class="text-gray-500 text-sm">@p.Descripcion</span>
                                    }
                                </div>
                                <button class="btn btn-sm btn-outline-danger" disabled="@_perfilesBusy"
                                        @onclick="() => RemovePerfilAsync(p)" title="Retirar">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                        <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8"/>
                                    </svg>
                                </button>
                            </li>
                        }
                    </ul>
                }

                <hr />
                <p class="font-semibold text-sm mb-1">Perfiles disponibles</p>
                @if (_perfilesDisponibles.Count == 0)
                {
                    <p class="text-gray-500 text-sm">No hay perfiles disponibles para agregar.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var p in _perfilesDisponibles)
                        {
                            <li class="list-group-item flex items-center justify-between px-0">
                                <div>
                                    <span class="font-semibold">@p.Nombre</span>
                                    @if (!string.IsNullOrEmpty(p.Descripcion))
                                    {
                                        <br /><span class="text-gray-500 text-sm">@p.Descripcion</span>
                                    }
                                </div>
                                <button class="btn btn-sm btn-outline-success" disabled="@_perfilesBusy"
                                        @onclick="() => AddPerfilAsync(p)" title="Agregar">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                                    </svg>
                                </button>
                            </li>
                        }
                    </ul>
                }
            }
        </div>
        <div class="app-modal__footer">
            <button class="btn btn-secondary" @onclick="() => _perfilesDialogVisible = false">Cerrar</button>
        </div>
    </div>
}

<!-- Modal: Confirmación baja -->
@if (_deleteDialogVisible)
{
    <div class="app-modal-backdrop" @onclick="() => _deleteDialogVisible = false"></div>
    <div class="app-modal app-modal--sm" role="dialog" aria-modal="true">
        <div class="app-modal__header">
            <h5 class="app-modal__title">Confirmar eliminación</h5>
            <button class="btn-close" @onclick="() => _deleteDialogVisible = false" aria-label="Cerrar"></button>
        </div>
        <div class="app-modal__body">
            <p>¿Está seguro que desea eliminar al usuario <strong>@_deletingUsuario?.Username</strong>?</p>
            <p class="text-gray-500 text-sm mb-0">Esta acción no se puede deshacer.</p>
        </div>
        <div class="app-modal__footer">
            <button class="btn btn-secondary" @onclick="() => _deleteDialogVisible = false" disabled="@_isDeleting">Cancelar</button>
            <button class="btn btn-danger btn-action" @onclick="ExecuteDeleteAsync" disabled="@_isDeleting">
                @if (_isDeleting)
                {
                    <span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
                }
                Eliminar
            </button>
        </div>
    </div>
}

@code {
    private Tabla<UsuarioResponse>? _tablaRef;
    private readonly int[] _pageSizes = [10, 20, 50];
    private CancellationTokenSource? _searchDebounceCts;

    private List<PersonaResponse> _todasPersonas = [];
    private List<PerfilDto> _todosPerfiles = [];
    private string _searchText = string.Empty;
    private string? _toast;
    private bool _toastIsError;

    private bool _createDialogVisible;
    private bool _isSaving;
    private readonly UsuarioCreateDto _createModel = new();
    private PersonaResponse? _selectedPersona;
    private string _personaSearchText = string.Empty;

    private bool _editDialogVisible;
    private UsuarioResponse? _editingUsuario;
    private readonly UsuarioUpdateDto _editModel = new();

    private bool _perfilesDialogVisible;
    private bool _perfilesLoading;
    private bool _perfilesBusy;
    private UsuarioResponse? _perfilesUsuario;
    private List<PerfilDto> _perfilesAsignados = [];
    private List<PerfilDto> _perfilesDisponibles = [];

    private bool _deleteDialogVisible;
    private bool _isDeleting;
    private UsuarioResponse? _deletingUsuario;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadPersonasAsync(), LoadPerfilesAsync());
    }

    private async Task LoadPersonasAsync() => _todasPersonas = await PersonaService.GetAllAsync();
    private async Task LoadPerfilesAsync() => _todosPerfiles = await PerfilService.GetAllAsync();

    private async Task<List<UsuarioResponse>> SearchUsuariosAsync(PaginacionDto paginacion, CancellationToken cancellationToken)
    {
        var table = await UsuarioService.GetTableAsync(paginacion, _searchText, cancellationToken);
        return table?.Registros ?? [];
    }

    private Task<int> CountUsuariosAsync(CancellationToken cancellationToken)
        => UsuarioService.CountAsync(_searchText, cancellationToken);

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;

        var previousCts = _searchDebounceCts;
        if (previousCts is not null)
        {
            await previousCts.CancelAsync();
            previousCts.Dispose();
        }

        _searchDebounceCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(250, _searchDebounceCts.Token);
            if (_tablaRef is not null)
                await _tablaRef.RefreshAsync(resetPage: true);
        }
        catch (OperationCanceledException)
        {
            return;
        }
    }

    private async Task RefreshUsuariosTablaAsync(bool resetPage = false)
    {
        if (_tablaRef is not null)
            await _tablaRef.RefreshAsync(resetPage);
    }

    private void OpenCreateDialog()
    {
        ResetCreateModel();
        _createDialogVisible = true;
    }

    private void CloseCreateDialog()
    {
        _createDialogVisible = false;
        ResetCreateModel();
    }

    private void ResetCreateModel()
    {
        _createModel.Username = string.Empty;
        _createModel.Password = string.Empty;
        _createModel.Email = string.Empty;
        _createModel.PersonaId = 0;
        _selectedPersona = null;
        _personaSearchText = string.Empty;
    }

    private async Task SaveCreateAsync()
    {
        var persona = _todasPersonas.FirstOrDefault(p =>
            $"{p.Apellidos}, {p.Nombres} — {p.Documento}".Equals(_personaSearchText, StringComparison.OrdinalIgnoreCase));
        if (persona is not null) { _selectedPersona = persona; _createModel.PersonaId = persona.Id; }

        if (_createModel.PersonaId == 0) { _ = ShowToastAsync("Debe seleccionar una persona vinculada.", true); return; }

        _isSaving = true;
        var result = await UsuarioService.CreateAsync(_createModel);
        _isSaving = false;

        if (result is not null)
        {
            _ = ShowToastAsync("Usuario creado correctamente.", false);
            CloseCreateDialog();
            await RefreshUsuariosTablaAsync(resetPage: true);
        }
        else
        {
            _ = ShowToastAsync("No se pudo crear el usuario. Verifique los datos.", true);
        }
    }

    private void OpenEditDialog(UsuarioResponse usuario)
    {
        _editingUsuario = usuario;
        _editModel.Username = usuario.Username;
        _editModel.Email = usuario.Email;
        _editModel.Password = null;
        _editDialogVisible = true;
    }

    private void CloseEditDialog()
    {
        _editDialogVisible = false;
        _editingUsuario = null;
        _editModel.Password = null;
    }

    private async Task SaveEditAsync()
    {
        if (string.IsNullOrWhiteSpace(_editModel.Password)) _editModel.Password = null;
        if (_editingUsuario is null) return;

        _isSaving = true;
        var result = await UsuarioService.UpdateAsync(_editingUsuario.Id, _editModel);
        _isSaving = false;

        if (result is not null)
        {
            _ = ShowToastAsync("Usuario actualizado correctamente.", false);
            CloseEditDialog();
            await RefreshUsuariosTablaAsync();
        }
        else
        {
            _ = ShowToastAsync("No se pudo actualizar el usuario.", true);
        }
    }

    private async Task OpenPerfilesDialog(UsuarioResponse usuario)
    {
        _perfilesUsuario = usuario;
        _perfilesDialogVisible = true;
        _perfilesLoading = true;

        var fresh = await UsuarioService.GetByIdAsync(usuario.Id);
        _perfilesAsignados = fresh?.Perfiles ?? [.. usuario.Perfiles];
        _perfilesDisponibles = _todosPerfiles.Where(p => _perfilesAsignados.All(a => a.Id != p.Id)).ToList();

        _perfilesLoading = false;
    }

    private async Task AddPerfilAsync(PerfilDto perfil)
    {
        if (_perfilesUsuario is null) return;
        _perfilesBusy = true;
        var ok = await UsuarioService.AssignPerfilAsync(_perfilesUsuario.Id, perfil.Id);
        if (ok)
        {
            _perfilesAsignados.Add(perfil);
            _perfilesDisponibles.Remove(perfil);
            _ = ShowToastAsync($"Perfil \"{perfil.Nombre}\" asignado.", false);
            await RefreshUsuariosTablaAsync();
        }
        else _ = ShowToastAsync($"No se pudo asignar el perfil \"{perfil.Nombre}\".", true);
        _perfilesBusy = false;
    }

    private async Task RemovePerfilAsync(PerfilDto perfil)
    {
        if (_perfilesUsuario is null) return;
        _perfilesBusy = true;
        var ok = await UsuarioService.UnassignPerfilAsync(_perfilesUsuario.Id, perfil.Id);
        if (ok)
        {
            _perfilesAsignados.Remove(perfil);
            _perfilesDisponibles.Add(perfil);
            _ = ShowToastAsync($"Perfil \"{perfil.Nombre}\" retirado.", false);
            await RefreshUsuariosTablaAsync();
        }
        else _ = ShowToastAsync($"No se pudo retirar el perfil \"{perfil.Nombre}\".", true);
        _perfilesBusy = false;
    }

    private void ConfirmDelete(UsuarioResponse usuario) { _deletingUsuario = usuario; _deleteDialogVisible = true; }

    private async Task ExecuteDeleteAsync()
    {
        if (_deletingUsuario is null) return;
        _isDeleting = true;
        var ok = await UsuarioService.DeleteAsync(_deletingUsuario.Id);
        _isDeleting = false;

        if (ok)
        {
            _ = ShowToastAsync("Usuario eliminado correctamente.", false);
            _deleteDialogVisible = false;
            _deletingUsuario = null;
            await RefreshUsuariosTablaAsync();
        }
        else _ = ShowToastAsync("No se pudo eliminar el usuario.", true);
    }

    private async Task ShowToastAsync(string message, bool isError)
    {
        _toast = message;
        _toastIsError = isError;
        StateHasChanged();
        await Task.Delay(3500);
        _toast = null;
        StateHasChanged();
    }
}


