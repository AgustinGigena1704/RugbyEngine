@page "/Admin/Registro/Personas"
@attribute [Authorize]
@using RugbyEngine.Shared.Tablas

@inject IPersonaService PersonaService

<PageTitle>Personas</PageTitle>

<!-- Toast -->
@if (_toast is not null)
{
    <div class="app-toast @(_toastIsError ? "app-toast--error" : "app-toast--success")" role="alert">
        @_toast
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <h4 class="mb-0 fw-bold">Gestión de Personas</h4>
    <button class="btn btn-primary btn-action" @onclick="OpenCreateDialog">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
        </svg>
        Nueva Persona
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body p-3">
        <div class="mb-3">
            <input type="search" class="form-control" placeholder="Buscar por nombre o documento..."
                   value="@_searchText" @oninput="OnSearchInput" />
        </div>

        <Tabla T="PersonaResponse"
               @ref="_tablaRef"
               Paginacion="true"
               SearchFunc="SearchPersonasAsync"
               CountFunc="CountPersonasAsync"
               PageSizes="_pageSizes"
               EmptyText="No se encontraron personas.">
            <Header>
                <Columna Nombre="Apellidos" />
                <Columna Nombre="Nombres" />
                <Columna Nombre="Documento" />
                <Columna Nombre="Fecha Nac." />
                <Columna Nombre="Teléfono" />
                <Columna Nombre="Email" />
                <Columna Nombre="Acciones" />
            </Header>
            <Rows>
                <Row T="PersonaResponse" Context="p">@p.Apellidos</Row>
                <Row T="PersonaResponse" Context="p">@p.Nombres</Row>
                <Row T="PersonaResponse" Context="p">@p.Documento</Row>
                <Row T="PersonaResponse" Context="p">@p.FechaNacimiento.ToString("dd/MM/yyyy")</Row>
                <Row T="PersonaResponse" Context="p">@(p.Telefono ?? "-")</Row>
                <Row T="PersonaResponse" Context="p">@(p.Email ?? "-")</Row>
                <Row T="PersonaResponse" Context="p">
                    <div class="td-actions">
                        <button class="btn btn-sm btn-outline-primary btn-action me-1" title="Editar" @onclick="() => OpenEditDialog(p)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.499.499 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z" />
                            </svg>
                            <span class="d-none d-lg-inline ms-1">Editar</span>
                        </button>
                        <button class="btn btn-sm btn-outline-danger btn-action" title="Eliminar" @onclick="() => ConfirmDelete(p)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4L4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                            </svg>
                            <span class="d-none d-lg-inline ms-1">Eliminar</span>
                        </button>
                    </div>
                </Row>
            </Rows>
        </Tabla>
    </div>
</div>

<!-- Modal: Alta / Modificación -->
@if (_dialogVisible)
{
    <div class="app-modal-backdrop" @onclick="CloseDialog"></div>
    <div class="app-modal" role="dialog" aria-modal="true">
        <div class="app-modal__header">
            <h5 class="app-modal__title">@(_editingId.HasValue ? "Editar Persona" : "Nueva Persona")</h5>
            <button class="btn-close" @onclick="CloseDialog" aria-label="Cerrar"></button>
        </div>
        <div class="app-modal__body">
            <EditForm Model="_formModel" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label">Nombres <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="_formModel.Nombres" />
                        <ValidationMessage For="@(() => _formModel.Nombres)" class="text-danger small" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label">Apellidos <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="_formModel.Apellidos" />
                        <ValidationMessage For="@(() => _formModel.Apellidos)" class="text-danger small" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label">Documento <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="_formModel.Documento" />
                        <ValidationMessage For="@(() => _formModel.Documento)" class="text-danger small" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label">Fecha de Nacimiento <span class="text-danger">*</span></label>
                        <InputDate class="form-control" @bind-Value="_formModel.FechaNacimiento" />
                        <ValidationMessage For="@(() => _formModel.FechaNacimiento)" class="text-danger small" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label">Cobertura médica</label>
                        <InputText class="form-control" @bind-Value="_formModel.Cobertura" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label">Nro. Afiliado</label>
                        <InputText class="form-control" @bind-Value="_formModel.NroAfiliado" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label">Teléfono</label>
                        <InputText class="form-control" @bind-Value="_formModel.Telefono" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label">Email</label>
                        <InputText type="email" class="form-control" @bind-Value="_formModel.Email" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Domicilio</label>
                        <InputText class="form-control" @bind-Value="_formModel.Domicilio" />
                    </div>
                </div>
                <div class="app-modal__footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDialog" disabled="@_isSaving">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-action" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        Guardar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Modal: Confirmación de baja -->
@if (_deleteDialogVisible)
{
    <div class="app-modal-backdrop" @onclick="() => _deleteDialogVisible = false"></div>
    <div class="app-modal app-modal--sm" role="dialog" aria-modal="true">
        <div class="app-modal__header">
            <h5 class="app-modal__title">Confirmar eliminación</h5>
            <button class="btn-close" @onclick="() => _deleteDialogVisible = false" aria-label="Cerrar"></button>
        </div>
        <div class="app-modal__body">
            <p>¿Está seguro que desea eliminar a <strong>@_deletingPersona?.Apellidos, @_deletingPersona?.Nombres</strong>?</p>
            <p class="text-muted small mb-0">Esta acción no se puede deshacer.</p>
        </div>
        <div class="app-modal__footer">
            <button class="btn btn-secondary" @onclick="() => _deleteDialogVisible = false" disabled="@_isDeleting">Cancelar</button>
            <button class="btn btn-danger btn-action" @onclick="ExecuteDeleteAsync" disabled="@_isDeleting">
                @if (_isDeleting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                Eliminar
            </button>
        </div>
    </div>
}

@code {
    private Tabla<PersonaResponse>? _tablaRef;
    private string _searchText = string.Empty;
    private readonly int[] _pageSizes = [10, 20, 50];

    private string? _toast;
    private bool _toastIsError;

    private bool _dialogVisible;
    private bool _isSaving;
    private int? _editingId;
    private readonly PersonaRequest _formModel = new();

    private bool _deleteDialogVisible;
    private bool _isDeleting;
    private PersonaResponse? _deletingPersona;

    private async Task<List<PersonaResponse>> SearchPersonasAsync(PaginacionDto paginacion)
    {
        var table = await PersonaService.GetTableAsync(paginacion);
        var registros = table?.Registros ?? [];

        if (string.IsNullOrWhiteSpace(_searchText))
            return registros;

        return registros.Where(MatchesSearch).ToList();
    }

    private async Task<int> CountPersonasAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchText))
        {
            var probe = await PersonaService.GetTableAsync(new PaginacionDto { Pagina = 1, RegistrosPorPagina = 1 });
            return probe?.Paginacion.Total ?? 0;
        }

        var all = await PersonaService.GetAllAsync();
        return all.Count(MatchesSearch);
    }

    private bool MatchesSearch(PersonaResponse p)
    {
        return p.Nombres.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || p.Apellidos.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || p.Documento.Contains(_searchText, StringComparison.OrdinalIgnoreCase);
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;
        if (_tablaRef is not null)
            await _tablaRef.RefreshAsync(resetPage: true);
    }

    private void OpenCreateDialog()
    {
        _editingId = null;
        ResetForm();
        _dialogVisible = true;
    }

    private void OpenEditDialog(PersonaResponse persona)
    {
        _editingId = persona.Id;
        _formModel.Nombres = persona.Nombres;
        _formModel.Apellidos = persona.Apellidos;
        _formModel.Documento = persona.Documento;
        _formModel.FechaNacimiento = persona.FechaNacimiento;
        _formModel.Cobertura = persona.Cobertura;
        _formModel.NroAfiliado = persona.NroAfiliado;
        _formModel.Telefono = persona.Telefono;
        _formModel.Email = persona.Email;
        _formModel.Domicilio = persona.Domicilio;
        _dialogVisible = true;
    }

    private async Task SaveAsync()
    {
        _isSaving = true;

        PersonaResponse? result = _editingId.HasValue
            ? await PersonaService.UpdateAsync(_editingId.Value, _formModel)
            : await PersonaService.CreateAsync(_formModel);

        _isSaving = false;

        if (result is not null)
        {
            _ = ShowToastAsync(_editingId.HasValue ? "Persona actualizada correctamente." : "Persona creada correctamente.", false);
            CloseDialog();
            await RefreshAfterMutationAsync();
        }
        else
        {
            _ = ShowToastAsync("No se pudo guardar. Verifique los datos o intente más tarde.", true);
        }
    }

    private void CloseDialog()
    {
        _dialogVisible = false;
        ResetForm();
    }

    private void ResetForm()
    {
        _formModel.Nombres = string.Empty;
        _formModel.Apellidos = string.Empty;
        _formModel.Documento = string.Empty;
        _formModel.FechaNacimiento = default;
        _formModel.Cobertura = null;
        _formModel.NroAfiliado = null;
        _formModel.Telefono = null;
        _formModel.Email = null;
        _formModel.Domicilio = null;
    }

    private void ConfirmDelete(PersonaResponse persona)
    {
        _deletingPersona = persona;
        _deleteDialogVisible = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deletingPersona is null) return;

        _isDeleting = true;
        var success = await PersonaService.DeleteAsync(_deletingPersona.Id);
        _isDeleting = false;

        if (success)
        {
            _ = ShowToastAsync("Persona eliminada correctamente.", false);
            _deleteDialogVisible = false;
            _deletingPersona = null;
            await RefreshAfterMutationAsync();
        }
        else
        {
            _ = ShowToastAsync("No se pudo eliminar la persona. Intente más tarde.", true);
        }
    }

    private async Task RefreshAfterMutationAsync()
    {
        if (_tablaRef is not null)
            await _tablaRef.RefreshAsync();
    }

    private async Task ShowToastAsync(string message, bool isError)
    {
        _toast = message;
        _toastIsError = isError;
        StateHasChanged();
        await Task.Delay(3500);
        _toast = null;
        StateHasChanged();
    }
}


