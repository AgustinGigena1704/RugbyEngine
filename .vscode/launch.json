{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RugbyEngine.Api",
      "type": "dotnet",
      "request": "launch",
      "preLaunchTask": "build",
      "projectPath": "${workspaceFolder}/RugbyEngine.Api/RugbyEngine.Api.csproj",
    },
    {
      "name": "RugbyEngine.Client (WASM)",
      "type": "editor-browser",
      "request": "launch",
      "url": "http://localhost:5268",
      "webRoot": "${workspaceFolder}/RugbyEngine.Client",
      "presentation": {
        "group": "new",
        "hidden": false
      },
      "preLaunchTask": "run-client"
    }
  ],
  "compounds": [
    {
      "name": "RugbyEngine (Client + Api)",
      "configurations": [
        "RugbyEngine.Api",
        "RugbyEngine.Client (WASM)"
      ],
      "stopAll": true
    }
  ]
}
