[Unit]
Description=RugbyEngine API
After=network.target

[Service]
WorkingDirectory=/home/agigena/rugbyengine
ExecStart=/usr/bin/dotnet /home/agigena/rugbyengine/RugbyEngine.Api.dll
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=rugbyengine
User=agigena

# Variables de entorno — el .env define DB_*, JWT_*
EnvironmentFile=/home/agigena/rugbyengine/.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://localhost:8080

[Install]
WantedBy=multi-user.target
